# ==============================================================================
# SIH26162 — THERMOSAFE AI: FULL-STACK ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to respective backend/.env and frontend/.env files.
# DO NOT COMMIT PRODUCTION SECRETS OR .env FILES TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT CONFIGURATION (frontend/.env or config.js)
# ------------------------------------------------------------------------------
# Target Backend API URL (without trailing slash)
# For local development: http://localhost:8000
# For production (if separate frontend/backend): https://your-backend.onrender.com
# For unified deployment: leave blank or set to origin
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT CONFIGURATION (backend/.env or Cloud Environment Variables)
# ------------------------------------------------------------------------------
APP_NAME="THERMOSAFE AI Backend"
APP_ENV=production                  # "development" | "production"
DEBUG=False                         # MUST be False in production
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# CORS Allowed Origins (Comma-separated or JSON list of frontend URLs)
# Example: https://your-frontend.vercel.app,https://your-domain.com
CORS_ORIGINS=["*"]

# Database Connection URL:
# - SQLite (Dev / Ephemeral demo): sqlite:///./sih26162.db
# - PostgreSQL (Production): postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///./sih26162.db

# JWT Security
# Generate a secure 256-bit secret for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-secure-256-bit-hex-secret-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Satellite Telemetry & NASA FIRMS API
# Obtain free key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
SATELLITE_DATA_MODE=live            # "live" | "demo"
FIRMS_MAP_KEY=
NASA_FIRMS_API_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov
NASA_FIRMS_TIMEOUT_SECONDS=30

# Firebase Cloud Messaging & Push Notifications (Optional)
FIREBASE_PROJECT_ID=thermosafe-ai-sih26162
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_CREDENTIALS_PATH=
