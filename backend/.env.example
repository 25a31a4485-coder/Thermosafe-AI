# ==============================================================================
# SIH26162 — THERMOSAFE AI: BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure appropriate values for your deployment.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# --- Application Core Settings ---
APP_NAME="THERMOSAFE AI Backend"
# Environment mode: "development" | "staging" | "production"
APP_ENV=development
# Set DEBUG to False in production to avoid leaking internal stack traces and disable verbose SQL logging
DEBUG=True
# Network interface binding (use 0.0.0.0 in Docker/cloud environments)
HOST=0.0.0.0
# Port number the backend server listens on
PORT=8000
# Prefix for all REST API endpoints
API_PREFIX=/api

# --- CORS (Cross-Origin Resource Sharing) Configuration ---
# Allowed origins for web browsers.
# In development, you can use ["*"] or ["http://localhost:5173", "http://127.0.0.1:5173"]
# In production, specify exact domain names (e.g. ["https://thermosafe.yourdomain.com"])
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# --- Database Persistence Configuration ---
# Local Development (SQLite):
DATABASE_URL="sqlite:///./sih26162.db"
# Production (Managed PostgreSQL - AWS RDS, GCP Cloud SQL, Supabase, Neon):
# DATABASE_URL="postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>"

# --- Security & JWT Authentication ---
# MUST be replaced with a cryptographically secure random string in production.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="generate-a-secure-256-bit-hex-secret-for-production"
# Cryptographic signing algorithm
JWT_ALGORITHM="HS256"
# Access token validity lifetime in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Satellite & NASA FIRMS Telemetry Settings ---
# Operational mode:
# - "live": (Default) Connects directly to NASA FIRMS API for near real-time (NRT) MODIS & VIIRS telemetry.
# - "demo": Internal developer testing mode with simulated telemetry.
SATELLITE_DATA_MODE="live"
# 32-character Map Key required for live mode.
# Obtain a free key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY="your-nasa-firms-map-key"
NASA_FIRMS_API_KEY="your-nasa-firms-map-key"
# NASA FIRMS API base endpoint
NASA_FIRMS_BASE_URL="https://firms.modaps.eosdis.nasa.gov"
# Maximum timeout for satellite API requests in seconds
NASA_FIRMS_TIMEOUT_SECONDS=30
